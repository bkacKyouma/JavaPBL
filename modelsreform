}


package models;

import java.util.HashMap;
import java.util.Map;

// NOVO: não existia em lugar nenhum do fragmento original. Guarda os 3
// vínculos exigidos (confFauan, vincPassos, suspToin) num mapa só, em vez
// de precisar de 3 campos soltos na Protagonista.
public class GerenciadorRelacionamentos {

    private final Map<String, Relacionamento> vinculos;

    public GerenciadorRelacionamentos() {
        this.vinculos = new HashMap<>();
    }

    public void registrar(String personagem, int valorInicial) {
        vinculos.put(personagem, new Relacionamento(personagem, valorInicial));
    }

    public void ajustar(String personagem, int delta) {
        Relacionamento vinculo = vinculos.get(personagem);
        if (vinculo == null) {
            throw new IllegalArgumentException("Vínculo não registrado: " + personagem);
        }
        vinculo.ajustar(delta);
    }

    public int getValor(String personagem) {
        Relacionamento vinculo = vinculos.get(personagem);
        return vinculo == null ? 0 : vinculo.getValor();
    }
}


