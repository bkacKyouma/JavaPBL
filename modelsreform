package models;
 
import java.util.ArrayList;
import java.util.List;
 
// NOVO: combina várias condições com E lógico (ex: relacionamento mínimo
// COM Toin E posse da pista, ao mesmo tempo).
public class CondicaoComposta implements CondicaoAcesso {
 
    private final List<CondicaoAcesso> condicoes;
 
    public CondicaoComposta() {
        this.condicoes = new ArrayList<>();
    }
 
    public void adicionar(CondicaoAcesso condicao) {
        condicoes.add(condicao);
    }
 
    @Override
    public boolean avaliar(EstadoJogo estado) {
        for (CondicaoAcesso c : condicoes) {
            if (!c.avaliar(estado)) return false;
        }
        return true;
    }
}



package models;

// NOVO: não existia. Sem isso, Escolha não tinha NENHUMA consequência real
// — só apontava pra próxima cena.
public class Efeito {

    public enum Alvo { MEMORIA, ESTABILIDADE, CULPA, RELACIONAMENTO }

    private final Alvo alvo;
    private final int delta;
    private final String personagemRelacionado; // só usado se alvo == RELACIONAMENTO

    public Efeito(Alvo alvo, int delta) {
        this(alvo, delta, null);
    }

    public Efeito(Alvo alvo, int delta, String personagemRelacionado) {
        this.alvo = alvo;
        this.delta = delta;
        this.personagemRelacionado = personagemRelacionado;
    }

    public void aplicar(EstadoJogo estado) {
        Atributos atributos = estado.getProtagonista().getAtributos();
        switch (alvo) {
            case MEMORIA: atributos.ajustarMemoria(delta); break;
            case ESTABILIDADE: atributos.ajustarEstabilidade(delta); break;
            case CULPA: atributos.ajustarCulpa(delta); break;
            case RELACIONAMENTO:
                estado.getProtagonista().getRelacionamentos().ajustar(personagemRelacionado, delta);
                break;
        }
    }
}


