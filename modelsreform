public interface CondicaoAcesso {
    boolean avaliar(EstadoJogo estado);
}



package models;
 
// NOVO.
public class CondicaoAtributoMinimo implements CondicaoAcesso {
 
    public enum TipoAtributo { MEMORIA, ESTABILIDADE, CULPA }
 
    private final TipoAtributo tipo;
    private final int valorMinimo;
 
    public CondicaoAtributoMinimo(TipoAtributo tipo, int valorMinimo) {
        this.tipo = tipo;
        this.valorMinimo = valorMinimo;
    }
 
    @Override
    public boolean avaliar(EstadoJogo estado) {
        Atributos atributos = estado.getProtagonista().getAtributos();
        int valorAtual;
        switch (tipo) {
            case MEMORIA: valorAtual = atributos.getMemoria(); break;
            case ESTABILIDADE: valorAtual = atributos.getEstabilidade(); break;
            default: valorAtual = atributos.getCulpa();
        }
        return valorAtual >= valorMinimo;
    }
}



