package models;

// NOVO: não existia. Substitui o que seria o antigo
// "List<Integer> caracteristicas" da Protagonista — aqui os três atributos
// têm nome próprio e método próprio, em vez de índice mágico numa lista.
public class Atributos {

    private int memoria;
    private int estabilidadeEmocional;
    private int culpaPercebida;

    public Atributos() {
        this.memoria = 0;
        this.estabilidadeEmocional = 50;
        this.culpaPercebida = 50;
    }

    public void ajustarMemoria(int delta) { memoria = clamp(memoria + delta); }
    public void ajustarEstabilidade(int delta) { estabilidadeEmocional = clamp(estabilidadeEmocional + delta); }
    public void ajustarCulpa(int delta) { culpaPercebida = clamp(culpaPercebida + delta); }

    public int getMemoria() { return memoria; }
    public int getEstabilidade() { return estabilidadeEmocional; }
    public int getCulpa() { return culpaPercebida; }

    private int clamp(int valor) { return Math.max(0, Math.min(100, valor)); }
}


